# SitRepHQ secrets
#
# Copy to .env in the directory you start sitrep from, or load it with systemd
# EnvironmentFile= or docker --env-file. Variables already set in the environment
# win over this file.
#
# Only set the variables your config.yml references. Every name here is just the
# one used in config.example.yml; rename them freely as long as config.yml matches.
# Keep this file out of git and readable only by the user running sitrep (chmod 600).

# http-json "do-billing": DigitalOcean API token. A read-only token with billing
# scope is enough.
DO_TOKEN=

# command "glacier": credentials for the aws CLI. The command inherits sitrep's
# environment, so these never appear in config.yml. Scope the IAM user to
# cloudwatch:GetMetricStatistics and cloudwatch:ListMetrics.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed if your aws commands don't pass --region.
# AWS_DEFAULT_REGION=us-east-1

# pihole "dns": a Pi-hole v6 app password (Settings > Web interface / API).
PIHOLE_PASSWORD=

# unifi "net": API key created inside the UniFi Network app
# (Settings > Control Plane > Integrations), not in Site Manager.
UNIFI_KEY=

# http-json "forgejo": Forgejo or Gitea access token with read:repository scope.
# A private repo returns 404, not 403, when the token is missing or lacks scope.
FORGEJO_TOKEN=
